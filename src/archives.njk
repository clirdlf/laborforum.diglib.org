---
layout: base.njk
pagination:
  data: listings
  size: 1
  alias: listing
permalink: "{{ listing.url }}"
---
<header class="{{ 'screen-reader-text' if listing.hideTitle else 'page-header' }}"><h1 class="page-title">{{ listing.title }}</h1></header>
{% for record in listing.posts %}<article id="post-{{ record.id }}" class="post type-post status-publish hentry"><header class="entry-header"><h2 class="entry-title"><a href="{{ record.url }}">{{ record.title }}</a></h2></header><div class="entry-content"><p>{{ record | excerpt }}…</p><p class="post-continuation"><a href="{{ record.url }}">Continue reading<span class="screen-reader-text">: {{ record.title }}</span></a></p></div>{% include 'post-meta.njk' %}</article>{% endfor %}
{% if listing.previousUrl or listing.nextUrl %}<nav aria-label="Posts pagination">{% if listing.previousUrl %}<a href="{{ listing.previousUrl }}">Previous page</a>{% endif %}{% if listing.nextUrl %}<a href="{{ listing.nextUrl }}">Next page</a>{% endif %}</nav>{% endif %}

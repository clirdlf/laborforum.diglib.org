<aside id="secondary" class="sidebar widget-area" aria-label="Site resources">
<section class="widget_text widget widget_custom_html"><div class="textwidget custom-html-widget"><a href="/code-of-conduct-and-community-agreement/">Code of Conduct and Community Agreement</a></div></section>
<section class="widget widget_search"><form role="search" aria-label="Sidebar archive" method="get" class="search-form" action="/search/"><label><span class="screen-reader-text">Search for:</span><input type="search" class="search-field" placeholder="Search …" name="q"></label><button type="submit" class="search-submit" aria-label="Search"><span class="screen-reader-text">Search</span></button></form></section>
<section class="widget_text widget widget_custom_html"><h2 class="widget-title"><span class="widget-title-icon" aria-hidden="true"></span>Contact</h2><div class="textwidget custom-html-widget"><a href="/contact/">Contact information</a></div></section>
<section class="widget widget_categories"><h2 class="widget-title"><span class="widget-title-icon" aria-hidden="true"></span>Categories</h2><ul>{% for category in archive.taxonomies.categories %}<li><a href="/category/{{ category.slug }}/">{{ category.name }}</a></li>{% endfor %}</ul></section>
</aside>

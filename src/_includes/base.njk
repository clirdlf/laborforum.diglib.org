<!doctype html>
<html lang="en" class="no-js">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ record.title or listing.title or title }} | Collective Responsibility</title>
<meta name="description" content="{{ archive.presentation.description }}">
<link rel="canonical" href="https://laborforum.diglib.org{{ page.url }}">
<link rel="stylesheet" href="/assets/css/fonts.css">
<link rel="stylesheet" href="/wp-content/themes/nucleus/genericons/genericons.css">
<link rel="stylesheet" href="/wp-content/themes/nucleus/style.css">
<link rel="stylesheet" href="/wp-content/themes/nucleus/css/blocks.css">
<link rel="stylesheet" href="/assets/css/site.css">
<script type="module" src="/assets/js/site.js"></script>
</head>
<body class="group-blog nucleus {{ 'single' if record.type == 'post' else 'page' }} {{ 'archive-listing' if listing }}">
<div id="page" class="site">
<div class="wrapper-top-bar"><div class="inner-top-bar"><div class="top-bar">
<div class="top-bar-name-and-description-site"><span class="top-bar-site-description">{{ archive.presentation.description }}</span></div>
<div class="top-bar-iconos-sociales-buscar"><a class="top-bar-icono-buscar" href="/search/" aria-label="Search the archive"><span class="gener-icon search" aria-hidden="true"></span></a></div>
</div></div></div>
<div class="site-inner">
<a class="skip-link screen-reader-text" href="#content">Skip to content</a>
<header id="masthead" class="site-header">
<div class="site-header-main"><div class="site-branding"><div class="wrapper-titulo-descripcion"><p class="site-title"><a href="/" rel="home">Collective Responsibility</a></p></div></div>
<button id="menu-toggle" class="menu-toggle" aria-controls="site-header-menu" aria-expanded="false">Menu</button>
<div id="site-header-menu" class="site-header-menu"><nav id="site-navigation" class="main-navigation" aria-label="Primary Menu"><div class="menu-header-container"><ul class="primary-menu">
{% for link in archive.navigation %}<li class="menu-item {{ 'current-menu-item' if page.url == link.url }}"><a href="{{ link.url }}"{% if page.url == link.url %} aria-current="page"{% endif %}>{{ link.title }}</a></li>{% endfor %}
</ul></div></nav></div></div>
<div class="header-image"><a href="/"><img src="{{ archive.presentation.banner }}" width="1260" height="294" alt="Collective Responsibility"></a></div>
</header>
<div id="content" class="site-content" tabindex="-1">
<div id="primary" class="content-area"><main id="main" class="site-main">{{ content | safe }}</main>
<aside id="content-bottom-widgets" class="content-bottom-widgets" aria-label="Image attribution and grant funding">{{ archive.presentation.bottomWidgets | archiveHtml | safe }}</aside>
</div>
{% include 'sidebar.njk' %}
</div></div>
<footer id="colophon"><div class="wrapper-footer-fuera-del-inner"><hr class="hr-oscura"><div class="site-info"><div class="site-info-item site-info-uno"></div><div class="site-info-item site-info-dos"></div><div class="site-info-item site-info-tres"><a href="https://galussothemes.com/wordpress-themes/nucleus/">Nucleus</a> by GalussoThemes.com<br>Permanent archive · Built with <a href="https://www.11ty.dev/">Eleventy</a></div></div></div></footer>
</div>
{% include 'accessibility.njk' %}
</body></html>

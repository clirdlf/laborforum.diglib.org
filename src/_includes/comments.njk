{% macro commentList(comments) %}<ol class="comment-list">{% for c in comments %}<li id="comment-{{ c.id }}" class="comment"><article class="comment-body"><header class="comment-meta"><b class="fn">{{ c.author }}</b><div class="comment-metadata"><a href="#comment-{{ c.id }}"><time datetime="{{ c.date | isoDate }}">{{ c.date | displayDate }}</time></a></div></header><div class="comment-content">{{ c.html | safe }}</div></article>{% if c.children.length %}{{ commentList(c.children) }}{% endif %}</li>{% endfor %}</ol>{% endmacro %}
{% if record.comments.length %}<section id="comments" class="comments-area"><h2 class="comments-title">{{ record.comments.length }} approved comment</h2>{{ commentList(record.comments | commentTree) }}<p class="comments-closed">Comments are preserved as read-only content. New comments are closed.</p></section>{% endif %}
